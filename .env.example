# Environment mode: development | staging | production
# In production: default ENCRYPTION_KEY is rejected at startup and X-Simulate-Failure is ignored.
ENVIRONMENT=development
ALLOW_FAILURE_SIMULATION=true

# 32-byte AES-256-GCM key encoded in URL-safe Base64.
# Generate a production key with:
#   python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Path to the mock audit log JSON Lines (.jsonl) database
AUDIT_LOG_PATH=data/audit_log.jsonl

# Simulated external AI call latency (seconds)
MOCK_AI_DELAY_SECONDS=2.0

# Circuit Breaker configuration
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT_SECONDS=30.0
